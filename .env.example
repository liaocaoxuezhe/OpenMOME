# ===== LLM（必填）：OpenAI 兼容接口，默认 DeepSeek =====
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# 换别家模型时填 LLM_API_KEY（优先于 DEEPSEEK_API_KEY），例如本地 Ollama：
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b

# ===== 说话人分离（可选）=====
# 需先在 https://huggingface.co/pyannote/speaker-diarization-community-1 接受条款
HF_TOKEN=

# ===== B站字幕（可选；不填则 B站一律本地转写）=====
# 两种写法都行：浏览器里复制的完整 Cookie 串，或只填 SESSDATA 的值
BILIBILI_COOKIE=

# ===== ASR（MVP 固定，一般不改）=====
# 默认 0.6B（速度约为 1.7B 的 2.5 倍）；更看重专有名词准确率时改成 Qwen/Qwen3-ASR-1.7B
ASR_MODEL=Qwen/Qwen3-ASR-0.6B

# ===== 服务 =====
HOST=127.0.0.1
PORT=8765
KEEP_AUDIO=false
MIN_FREE_GB=5
